//@version=5
indicator("MalloyAlgos: Momentum Based Oscillator [Optimized]", shorttitle="MalloyAlgos: MBO", overlay=false)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUT PARAMETERS
// ═══════════════════════════════════════════════════════════════════════════════

string core = "➞ ML Core Settings 🔸"
int shortPeriod = input.int(26, "Short Period", minval=1, group=core)
int longPeriod = input.int(14, "Long Period", minval=2, group=core)
int smoothPeriod = input.int(13, "Smoothing Period", minval=2, group=core)
int neighbourCount = input.int(50, "Neighbours Count", minval=5, maxval=500, group=core)

string arrow = "➞ Arrow Signals 🔸"
bool showArrows = input.bool(true, "Show Prediction Arrows", group=arrow)
bool showLines = input.bool(false, "Show ML Core Lines", group=arrow)
int arrowSensitivity = input.int(3, "Arrow Sensitivity (1-5)", minval=1, maxval=5, group=arrow)

// ═══════════════════════════════════════════════════════════════════════════════
// TYPE DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════════════

type MachineLearning
    array<float> momentum1
    array<float> momentum2
    array<int> direction
    array<int> predictions
    array<float> smoothedPreds

type MLData
    float momentum1
    float momentum2
    float distance
    float prediction
    float smoothed
    float band

// ═══════════════════════════════════════════════════════════════════════════════
// INITIALIZATION
// ═══════════════════════════════════════════════════════════════════════════════

var ml = MachineLearning.new(array.new_float(0), array.new_float(0), array.new_int(0), array.new_int(0), array.new_float(0))
var mdata = MLData.new()

var float oscillatorMin = 0.0
var float oscillatorMax = 0.0
var float prevPrediction = 0.0
var int prevDirection = 0
var array<int> arrowLabels = array.new<int>()
var int MAX_LABELS = 500

// ═══════════════════════════════════════════════════════════════════════════════
// METHODS
// ═══════════════════════════════════════════════════════════════════════════════

// Calculate volatility bands for oscillator bounds
method calculateBand(int len) =>
    volatilityHigh = math.min(ta.atr(len) * 0.3, close * (0.3 / 100))
    volatilitySmoothed = ta.sma(volatilityHigh, 20)
    volatilitySmoothed / 2

// Core momentum calculation: normalized momentum oscillator
method calculateMomentum(int period, int smooth) =>
    momentum = ta.ema(hlc3 - hlc3[1], period)
    absChange = ta.ema(math.abs(hlc3 - hlc3[1]), period)
    momentum_smooth = ta.ema(momentum, smooth)
    absChange_smooth = ta.ema(absChange, smooth)

    // Normalize to prevent extreme values (safer division)
    normalized = absChange_smooth != 0 ? 100 * (momentum_smooth / absChange_smooth) : 0.0
    normalized

// K-Nearest Neighbors distance calculation (optimized)
method distanceMetric(float m1_current, float m1_hist, float m2_current, float m2_hist) =>
    // Manhattan distance (faster than Euclidean)
    math.abs(m1_current - m1_hist) + math.abs(m2_current - m2_hist)

// K-NN prediction with rolling window optimization
method predictKnn(MachineLearning ml_data) =>
    if ml_data.predictions.size() == 0
        0.0
    else
        float minDist = math.max_int
        maxSearchWindow = math.min(ml_data.direction.size(), neighbourCount * 3)

        for i = 0 to maxSearchWindow - 1
            idx = ml_data.direction.size() - 1 - i
            if idx >= 0
                dist = distanceMetric(mdata.momentum1, ml_data.momentum1.get(idx), 
                                    mdata.momentum2, ml_data.momentum2.get(idx))
                if dist < minDist
                    minDist := dist
                    if ml_data.predictions.size() >= neighbourCount
                        ml_data.predictions.shift()
                    ml_data.predictions.push(ml_data.direction.get(idx))

        // Return normalized average prediction (0-1 range)
        predSize = ml_data.predictions.size()
        if predSize > 0
            float(ml_data.predictions.sum()) / float(predSize)
        else
            0.0

// Detect potential big moves (arrows)
method detectArrowSignal(float currentPred, float smoothedPred, int direction) =>
    arrow = 0

    // Bullish arrow: strong divergence + direction change
    oscillatorRange = math.abs(oscillatorMax - oscillatorMin)
    threshold = oscillatorRange > 0 ? oscillatorRange * 0.3 / float(arrowSensitivity) : 0

    if currentPred > smoothedPred and currentPred > 0 and prevDirection <= 0 and math.abs(currentPred) > threshold
        arrow := 1

    // Bearish arrow: strong divergence + direction change
    if currentPred < smoothedPred and currentPred < 0 and prevDirection >= 0 and math.abs(currentPred) > threshold
        arrow := -1

    arrow

// Clean up old labels (prevent memory issues)
method cleanupLabels() =>
    if arrowLabels.size() > MAX_LABELS
        for i = 0 to MAX_LABELS / 2
            lbl = arrowLabels.shift()
            label.delete(label(lbl))

// ═══════════════════════════════════════════════════════════════════════════════
// MAIN CALCULATION LOOP
// ═══════════════════════════════════════════════════════════════════════════════

// Calculate momentum values
mdata.momentum1 := calculateMomentum(longPeriod, smoothPeriod)
mdata.momentum2 := calculateMomentum(shortPeriod, smoothPeriod)
mdata.band := calculateBand(30) * 2.5

maxBand = mdata.momentum2 + mdata.band
minBand = mdata.momentum2 - mdata.band

// Direction classification: -1 (down), 0 (flat), 1 (up)
direction = mdata.momentum1 > mdata.momentum1[1] ? 1 : mdata.momentum1 < mdata.momentum1[1] ? -1 : 0

// Update ML data arrays (only keep relevant history to optimize)
if ml.direction.size() > neighbourCount * 5
    ml.momentum1.shift()
    ml.momentum2.shift()
    ml.direction.shift()

ml.momentum1.push(mdata.momentum1)
ml.momentum2.push(mdata.momentum2)
ml.direction.push(direction)

// Perform K-NN prediction
mdata.prediction := predictKnn(ml)
mdata.smoothed := ta.sma(mdata.prediction, smoothPeriod)

if ml.smoothedPreds.size() <= 500
    ml.smoothedPreds.push(mdata.smoothed)
else
    ml.smoothedPreds.shift()
    ml.smoothedPreds.push(mdata.smoothed)

// Update oscillator bounds safely
minVal = ml.smoothedPreds.size() > 0 ? ml.smoothedPreds.min() : 0.0
maxVal = ml.smoothedPreds.size() > 0 ? ml.smoothedPreds.max() : 0.0

oscillatorMin := minVal
oscillatorMax := maxVal

// ═══════════════════════════════════════════════════════════════════════════════
// ARROW DETECTION & CLEANUP
// ═══════════════════════════════════════════════════════════════════════════════

arrowSignal = detectArrowSignal(mdata.prediction, mdata.smoothed, direction)
cleanupLabels()

// ═══════════════════════════════════════════════════════════════════════════════
// PLOTTING & VISUALIZATION
// ═══════════════════════════════════════════════════════════════════════════════

// Gradient colors
bullishColor = color.from_gradient(mdata.prediction, oscillatorMin, oscillatorMax, color.rgb(166, 7, 187), color.rgb(107, 0, 107))
bearishColor = color.from_gradient(mdata.prediction, oscillatorMin, oscillatorMax, color.rgb(231, 228, 21), color.rgb(255, 160, 82))
histogramColor = mdata.prediction > mdata.smoothed ? bullishColor : bearishColor

// Plot main indicators
p1 = plot(mdata.prediction, title="Prediction", color=color.new(color.white, 40), linewidth=1, editable=false)
p2 = plot(mdata.smoothed, title="Smoothed", color=color.new(color.yellow, 20), linewidth=2, editable=false)

// Plot bands
plot(oscillatorMax, title="Upper Band", color=color.new(color.white, 80), linewidth=1)
plot(oscillatorMin, title="Lower Band", color=color.new(color.white, 80), linewidth=1)

// Fill between prediction and smoothed
fill(p1, p2, color=color.new(histogramColor, 30))

// Prediction lines (optional)
plot(showLines ? mdata.momentum1 : na, title="Momentum 1", color=color.new(#efb906, 70), linewidth=2, editable=false)
plot(showLines ? mdata.momentum2 : na, title="Momentum 2", color=color.new(#08d3ed, 70), linewidth=2, editable=false)
plot(showLines ? maxBand : na, title="Max Band", color=color.new(#08edda, 80), linewidth=1, editable=false)
plot(showLines ? minBand : na, title="Min Band", color=color.new(#08edda, 80), linewidth=1, editable=false)

// Arrow signals for big moves
if showArrows
    if arrowSignal == 1
        arrowY = oscillatorMin - (oscillatorMax - oscillatorMin) * 0.1
        lbl = label.new(bar_index, arrowY, "▲", yloc=yloc.absolute, color=color.new(color.green, 0), textcolor=color.green, size=size.large, style=label.style_none)
        arrowLabels.push(lbl.get_id())
    else if arrowSignal == -1
        arrowY = oscillatorMax + (oscillatorMax - oscillatorMin) * 0.1
        lbl = label.new(bar_index, arrowY, "▼", yloc=yloc.absolute, color=color.new(color.red, 0), textcolor=color.red, size=size.large, style=label.style_none)
        arrowLabels.push(lbl.get_id())

// Update for next iteration
prevPrediction := mdata.prediction
prevDirection := direction
